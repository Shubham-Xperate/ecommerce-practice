# Copy to terraform.tfvars and adjust as needed -- terraform.tfvars itself
# is gitignored. Every value below is already the default in variables.tf,
# so an empty/missing terraform.tfvars works fine too.

location             = "swedencentral"
resource_group_name  = "rg-poc-dev"
acr_name             = "acrecommercepocdev"
key_vault_name       = "kv-ecommercepoc-dev"
aks_cluster_name     = "pocdevcluster"
aks_node_count       = 2
aks_node_vm_size     = "Standard_D2s_v5"
aks_sku_tier         = "Free"
